{
  "name": "@querion/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-preserve-output --import tsx src/server.ts",
    "start": "node --import tsx src/server.ts",
    "datasets:build": "tsx src/nebula/datasets/build.ts",
    "seed": "tsx src/cli/seed.ts",
    "forge": "tsx src/cli/forge.ts",
    "kaggle:sync": "tsx src/cli/kaggle.ts",
    "typecheck": "tsc -p tsconfig.json",
    "doctor": "tsx src/cli/doctor.ts",
    "mail:test": "tsx src/cli/mail-test.ts",
    "judge:snapshot": "node --liftoff-only --import tsx src/cli/judge-snapshot.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@hono/node-server": "^2.1.6",
    "@querion/engine": "workspace:^",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.9",
    "fflate": "^0.8.3",
    "hono": "^4.13.17",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
