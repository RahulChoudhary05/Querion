# ─── Querion API ───────────────────────────────────────────────
NODE_ENV=development
PORT=8787
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
# Required in production (any long random string)
JWT_SECRET=change-me
# Enables /api/admin/* (manual forge, Kaggle sync, run logs)
ADMIN_TOKEN=

# ─── Database ──────────────────────────────────────────────────
# pglite   → zero-setup embedded Postgres stored in ./.data (default)
# postgres → any Postgres via DATABASE_URL (Neon / Supabase free tier)
DB_DRIVER=pglite
DATABASE_URL=

# ─── AI (both have free tiers; either one is enough) ───────────
# Groq:   https://console.groq.com/keys
GROQ_API_KEY=
# Main Groq model (tried first); GROQ_MODELS are fallbacks
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-2.5-flash
# Provider priority / fallback order
AI_PROVIDERS=groq,gemini

# ─── Kaggle (monthly dataset refresh) ──────────────────────────
# https://www.kaggle.com/settings → API → Create New Token
KAGGLE_USERNAME=
KAGGLE_KEY=
# Also ingest one trending, openly-licensed CSV dataset per month
KAGGLE_DISCOVER=false

# ─── Nebula ────────────────────────────────────────────────────
SCHEDULER_ENABLED=true
# Reject generated problems that a second model cannot solve from the statement alone
FORGE_REQUIRE_BLIND_SOLVE=true
JUDGE_WORKERS=2
JUDGE_TIMEOUT_MS=8000

# ─── Edge proxy (Cloudflare Pages Function) ───────────────────
# Same random value in Pages (env PROXY_SECRET) and here, so the API trusts the visitor IP it forwards.
PROXY_SECRET=
