{
  "name": "querion",
  "version": "2.0.0",
  "private": true,
  "description": "Querion \u2014 a PostgreSQL studio with fresh, AI-forged, auto-verified SQL problems built from real Kaggle datasets.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"pnpm --filter @querion/api dev\" \"pnpm --filter @querion/web dev\"",
    "dev:api": "pnpm --filter @querion/api dev",
    "dev:web": "pnpm --filter @querion/web dev",
    "build": "pnpm --filter @querion/web build",
    "start": "pnpm --filter @querion/api start",
    "datasets:build": "pnpm --filter @querion/api datasets:build",
    "seed": "pnpm --filter @querion/api seed",
    "forge": "pnpm --filter @querion/api forge",
    "kaggle:sync": "pnpm --filter @querion/api kaggle:sync",
    "test": "pnpm --filter @querion/engine test && pnpm --filter @querion/api test",
    "typecheck": "pnpm -r typecheck",
    "doctor": "pnpm --filter @querion/api doctor",
    "mail:test": "pnpm --filter @querion/api mail:test"
  },
  "devDependencies": {
    "@types/node": "22",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  }
}
